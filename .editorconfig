# Mizad — editor & code-style conventions (agent.md task 1.2)
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,targets,slnx,json,yml,yaml,manifest}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# ---- Layout ----
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_new_line_before_open_brace = all
csharp_prefer_braces = when_multiline:suggestion

# ---- var / expression preferences ----
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_prefer_primary_constructors = true:suggestion
dotnet_style_readonly_field = true:warning

# ---- Naming ----
dotnet_naming_rule.interfaces_begin_with_i.symbols = interface_symbols
dotnet_naming_rule.interfaces_begin_with_i.style = prefix_i
dotnet_naming_rule.interfaces_begin_with_i.severity = warning
dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_style.prefix_i.required_prefix = I
dotnet_naming_style.prefix_i.capitalization = pascal_case

dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = suggestion
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

dotnet_naming_rule.types_pascal.symbols = all_types
dotnet_naming_rule.types_pascal.style = pascal
dotnet_naming_rule.types_pascal.severity = warning
dotnet_naming_symbols.all_types.applicable_kinds = class, struct, enum, delegate, record
dotnet_naming_style.pascal.capitalization = pascal_case

# ---- Analyzer adjustments (documented) ----
# CA1303: user-facing strings are intentionally Arabic literals/resources, not localized via satellite assemblies.
dotnet_diagnostic.CA1303.severity = none
# CA1848/CA1873: LoggerMessage source-gen is not required for this desktop app's log volume; Serilog is used directly.
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none
# CA1716: names such as Error/Shared are VB keywords; Mizad is a C#-only product with no VB consumers.
dotnet_diagnostic.CA1716.severity = none
# CA2007: WPF needs the UI synchronization context after await; ConfigureAwait(false) must NOT be forced everywhere.
dotnet_diagnostic.CA2007.severity = none

# EF Core migrations are generated by `dotnet ef` and must not be hand-edited for style (D-043).
[src/Mizad.Infrastructure/Persistence/Migrations/**.cs]
generated_code = true

# Tests: method names use Method_Scenario_Expected with underscores.
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1515.severity = none
dotnet_diagnostic.CA1062.severity = none
