<Project Sdk="Microsoft.NET.Sdk">

  <!-- Integration tests against a REAL SQL Server (D-036). Connection: MIZAD_TEST_SQL or the local default instance. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Mizad.IntegrationTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Mizad.Domain\Mizad.Domain.csproj" />
    <ProjectReference Include="..\..\src\Mizad.Application\Mizad.Application.csproj" />
    <ProjectReference Include="..\..\src\Mizad.Infrastructure\Mizad.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

</Project>
