<Solution>
  <!-- Mizad.Desktop is the only executable project: DefaultStartup makes Visual Studio start it by default. -->
  <Folder Name="/src/">
    <Project Path="src/Mizad.Desktop/Mizad.Desktop.csproj" DefaultStartup="true" />
    <Project Path="src/Mizad.Domain/Mizad.Domain.csproj" />
    <Project Path="src/Mizad.Application/Mizad.Application.csproj" />
    <Project Path="src/Mizad.Infrastructure/Mizad.Infrastructure.csproj" />
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/Mizad.UnitTests/Mizad.UnitTests.csproj" />
    <Project Path="tests/Mizad.IntegrationTests/Mizad.IntegrationTests.csproj" />
  </Folder>
  <Folder Name="/Solution Items/">
    <File Path="Directory.Build.props" />
    <File Path="Directory.Packages.props" />
    <File Path="global.json" />
    <File Path="dotnet-tools.json" />
    <File Path=".editorconfig" />
    <File Path="agent.md" />
    <File Path="AGENT_INSTRUCTIONS.md" />
    <File Path="PROGRESS.md" />
    <File Path="DECISIONS.md" />
  </Folder>
</Solution>
