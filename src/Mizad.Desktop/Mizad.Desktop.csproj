<Project Sdk="Microsoft.NET.Sdk">

  <!-- WPF application and composition root. References Infrastructure ONLY for DI registration in Composition/. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Mizad</AssemblyName>
    <RootNamespace>Mizad.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mizad.Application\Mizad.Application.csproj" />
    <ProjectReference Include="..\Mizad.Domain\Mizad.Domain.csproj" />
    <ProjectReference Include="..\Mizad.Infrastructure\Mizad.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mizad.UnitTests" />
  </ItemGroup>

</Project>
